rules_version = '2';

// MYSLEWER Cloud Storage rules. First-ever use of Storage in this project
// (everything else runs on Firestore + static GitHub Pages hosting) - the
// Lift Plan Library is what needs actual file uploads, so this file
// starts life with exactly one purpose: its photos. Deploy the same way
// as firestore.rules - there's no firebase.json/CLI deploy pipeline
// wired up for this repo, so paste this into the Firebase Console's
// Storage -> Rules tab by hand whenever it changes.
service firebase.storage {
  match /b/{bucket}/o {

    // entryId matches liftLibraryEntries/{entryId} in firestore.rules -
    // generated client-side before either the Firestore doc or these
    // photos exist, so the two are always linked by the same id with no
    // round trip needed. Read is open to any signed-in user, same bar as
    // the Firestore side. Upload just needs to be a real image under a
    // sane size (15MB - generous for a phone photo, not generous enough
    // for someone to use this as general file storage). Delete checks
    // back against the OWNING FIRESTORE DOC's loggedByUid (cross-service
    // rules lookup) rather than duplicating an ownership field here -
    // one source of truth for "who logged this entry", same person who
    // can delete its photos. No update - a wrong photo means delete and
    // re-upload, not overwrite in place.
    match /liftLibrary/{entryId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.size < 15 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if request.auth != null
                     && firestore.get(/databases/(default)/documents/liftLibraryEntries/$(entryId)).data.loggedByUid == request.auth.uid;
    }

    // Deny everything else outright - same explicit-fallback discipline
    // as firestore.rules' own closing match, so nothing added later
    // accidentally inherits more access than intended just by sitting in
    // the same bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
