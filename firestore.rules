rules_version = '2';

// MYSLEWER access-gate Firestore rules. Two collections, both read-only
// from the client (all writes happen from the Firebase console's Data
// tab, by whoever administers invites) and both scoped so a signed-in
// user can only ever read their OWN record - never list a collection,
// never read someone else's. See methodology.txt for the full reasoning.
service cloud.firestore {
  match /databases/{database}/documents {

    // Root of trust for everything admin-related below. Deliberately the
    // ONE thing in this whole admin layer that stays out of the app
    // entirely - granting admin status is still a manual Admin-SDK
    // script action (same as every userAccess flag grant before this),
    // never toggleable from inside the app by anyone, including another
    // admin. That's on purpose: it means no admin can ever grant more
    // admins (or themselves more power) purely through the client, no
    // matter what else in this file gets built on top of isAdmin().
    // Single admin for now by explicit choice - the collection supports
    // more without any rule change if that's ever needed.
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Google Sign-In allowlist. Keyed by the person's lowercased email,
    // not their uid - unlike Password/Email Link (where an admin-created
    // Auth account already exists, and so a uid already exists, before
    // the person ever signs in), Firebase creates a Google-auth account
    // automatically the moment someone completes the OAuth popup, so
    // there's no uid to key this by until AFTER that popup already
    // happened. Email is the only thing available to check beforehand.
    // A document's mere existence isn't enough on its own - the client
    // also checks its `allowed` field is exactly `true`, so access can be
    // revoked by flipping that field to false without deleting the
    // record (keeps a paper trail of who was ever invited).
    match /googleAllowlist/{email} {
      allow get: if request.auth != null
                  && request.auth.token.email != null
                  && request.auth.token.email.lower() == email;
      allow list: if false;
      // Self-service grant via a redeemed invite token (see
      // inviteTokens/{token} below) - NOT yet exposed anywhere in the
      // app's UI (the "Invite a Colleague" generator only lives in the
      // hidden-for-now Admin Dashboard section), but the rule itself is
      // written for the real end state so no further rules redeploy is
      // needed once it IS exposed. Only lets someone create their OWN
      // doc (email must match their own token email - same constraint
      // every other self-write in this file already uses), and only by
      // citing a token this exact person (uid AND email both) has
      // already redeemed via the inviteTokens update below - never a
      // token someone else redeemed, never an unredeemed one. `update`
      // stays false - a person can create their own entry once via a
      // valid token, but can never re-arm or modify it themselves;
      // revoking access (allowed -> false) stays an admin/Console-only
      // action, same as it's always been.
      allow create: if request.auth != null
                     && request.auth.token.email != null
                     && request.auth.token.email.lower() == email
                     && request.resource.data.keys().hasOnly(['allowed', 'grantedViaToken'])
                     && request.resource.data.allowed == true
                     && request.resource.data.grantedViaToken is string
                     && get(/databases/$(database)/documents/inviteTokens/$(request.resource.data.grantedViaToken)).data.usedByUid == request.auth.uid
                     && get(/databases/$(database)/documents/inviteTokens/$(request.resource.data.grantedViaToken)).data.usedByEmail == email;
      allow update, delete: if false;
    }

    // One-time invite tokens - lets an already-allowlisted user hand a
    // brand new person a link/QR that self-grants them a googleAllowlist
    // entry (above), without an admin manually adding their email first.
    // Modelled on SafeDay's own "Invite a Colleague" QR flow. Redemption
    // is two SEQUENTIAL writes (same accepted non-atomic pattern as
    // pools/invites elsewhere in this file), deliberately ordered to
    // fail CLOSED rather than open if interrupted between them: the
    // token is marked used FIRST, tied to the redeemer's own uid+email,
    // and only THEN can that same person's googleAllowlist create above
    // succeed (it checks usedByUid/usedByEmail match). A crash between
    // the two steps leaves a burned token and no access granted - never
    // the reverse. The `used == false` precondition on update is also
    // what makes this genuinely one-time-use under concurrent
    // redemption attempts: Firestore evaluates that precondition against
    // the true current server document, so if two people race the same
    // token, only the first update can ever succeed.
    match /inviteTokens/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                     && request.auth.token.email != null
                     && get(/databases/$(database)/documents/googleAllowlist/$(request.auth.token.email.lower())).data.allowed == true
                     && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt', 'used'])
                     && request.resource.data.createdBy == request.auth.uid
                     && request.resource.data.used == false
                     && request.resource.data.createdAt is int
                     && request.resource.data.expiresAt is int
                     && request.resource.data.expiresAt >= request.time.toMillis()
                     && request.resource.data.expiresAt <= request.time.toMillis() + 1860000;
      allow update: if request.auth != null
                     && request.auth.token.email != null
                     && resource.data.used == false
                     && resource.data.expiresAt >= request.time.toMillis()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedByUid', 'usedByEmail', 'usedAt'])
                     && request.resource.data.used == true
                     && request.resource.data.usedByUid == request.auth.uid
                     && request.resource.data.usedByEmail == request.auth.token.email.lower()
                     && request.resource.data.usedAt is int;
      allow delete: if false;
    }

    // Per-user tab/crane restrictions. Keyed by Firebase Auth uid, which
    // IS always known by the time an admin would ever want to restrict
    // someone - the deny-list model (see methodology.txt) means nobody
    // NEEDS a document on day one; full access is the default for anyone
    // with no document at all, so there's no rush to create one before
    // a person's first sign-in reveals their uid in Authentication ->
    // Users. The `hidden` field is a flat map of short tab/sub-tab keys
    // to `true` for anything specifically hidden from that person -
    // see TAB_RESTRICTION_TARGETS in index.html for the exact key names.
    // Own-doc read stays exactly as it always has. Added for Stage 3: an
    // admin may get/list any user's doc (to build the dashboard's user
    // list) and write any user's flags (to toggle them) - the SAME
    // booleans applyFeatureAccess() in index.html already reads
    // (serviceFillAccess, assemblyPlansAccess, cabEntryAccess,
    // xPctHAccess) plus the existing `hidden` map, nothing new added to
    // what a flag can mean.
    match /userAccess/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if request.auth != null && isAdmin();
      allow write: if request.auth != null && isAdmin();
    }

    // Admin-only email lookup - separate from the public displayName
    // directory below on purpose. Every signed-in user gets one of these
    // written automatically (client writes its own, once, at sign-in -
    // see index.html), regardless of whether they've ever set a display
    // name, so the Admin Dashboard's user list can show and manage
    // someone from the moment they first sign in, not just once they've
    // gotten around to naming themselves. Deliberately NOT folded into
    // the public directory doc - email is more sensitive than a display
    // name, so it only ever goes to an admin, never to other users the
    // way a name does. `create`-only (no update) since the value is
    // always the account's own real token email, so there's nothing to
    // legitimately change it to later.
    match /userEmails/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.auth.token.email != null
                     && request.resource.data.keys().hasOnly(['email'])
                     && request.resource.data.email == request.auth.token.email.lower();
      allow update, delete: if false;
    }

    // Public-within-the-app directory of display names, for the shared
    // lift-log pool feature (invite someone by name instead of needing
    // their exact email). Deliberately the one collection any signed-in
    // user CAN list/get in full, not just their own doc - unlike
    // googleAllowlist/userAccess above, which only ever leak a yes/no
    // against a key you already know. The tradeoff is intentional: this
    // app is a small, invite-gated crew, not a public product, so
    // exposing display names (and ONLY display names - never email, never
    // anything else) to other already-signed-in users is low-risk and is
    // what makes the invite flow usable at all. A user may only write
    // their own doc, and only the displayName/updatedAt fields - nothing
    // here lets anyone write on another uid's behalf.
    match /directory/{uid} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 40;
    }

    // Shared lift-log pools. Nobody can ever list the `pools` collection
    // itself - only see pools they're already an active member of, same
    // no-browse discipline as googleAllowlist/userAccess above. Writes
    // here are meant to be issued as separate, sequential client calls
    // (create the pool, THEN create your own membership doc, THEN the
    // fan-out doc below) rather than one atomic batch - a touch less
    // atomic (a crash mid-sequence can leave an orphaned pool with no
    // member), but far simpler to reason about and verify correct than
    // relying on same-transaction read-your-own-writes visibility, and
    // an orphan here costs nothing - same "empty-pool cleanup is best-
    // effort, not instant" tradeoff already accepted for auto-delete.
    match /pools/{poolId} {
      allow get: if request.auth != null
                  && exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid));
      allow create: if request.auth != null
                     && request.resource.data.createdBy == request.auth.uid
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.name.size() <= 60;
      allow list, update, delete: if false;
    }

    // Pool membership. Only an active member of a pool can see who else
    // is in it. A person may only ever write their OWN membership doc,
    // and only in one of two specific shapes: setting it up as
    // 'active'/'member' either (a) as the pool's own creator, in the
    // sequential write immediately after creating the pool doc above, or
    // (b) after accepting a specific invite addressed to them - the
    // invites match below uses a deterministic poolId_uid document id
    // specifically so this rule can confirm a real accepted invite
    // exists via one direct-key lookup, not a query. The only other way
    // this doc ever changes: an admin (Stage 3) may update ONLY the
    // `role` field, to promote/demote member<->overseer - deliberately
    // scoped to pools the admin can already see (still has to already be
    // an active member of that pool themselves - no new "see every pool
    // in the app" carve-out was added for this, matching the original
    // design decision to keep that out of Stage 3's v1). Status only
    // ever changes by the member deleting their own doc to leave.
    match /pools/{poolId}/members/{uid} {
      allow get: if request.auth != null
                  && (request.auth.uid == uid
                      || exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid)));
      allow list: if request.auth != null
                   && exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.role == 'member'
                     && request.resource.data.status == 'active'
                     && (
                          get(/databases/$(database)/documents/pools/$(poolId)).data.createdBy == request.auth.uid
                          || get(/databases/$(database)/documents/invites/$(poolId + '_' + uid)).data.status == 'accepted'
                        );
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin()
                     && exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid))
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                     && request.resource.data.role in ['member', 'overseer'];
    }

    // The actual shared lift log. Any active member (member OR overseer)
    // can read it - that's the whole point of the overseer role, seeing
    // the log without needing to log lifts themselves - but only a
    // 'member' can create a new entry (an overseer viewing-only isn't
    // just a UI convention, it's enforced here too). Each entry is only
    // ever editable/deletable by whoever logged it - same "you can only
    // touch your own" shape as the local-only Lift Logger's own delete
    // button already had, just now enforced server-side since other
    // people can see (and would otherwise be able to touch) each other's
    // entries once the log is actually shared.
    match /pools/{poolId}/lifts/{liftId} {
      allow get, list: if request.auth != null
                         && exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid));
      allow create: if request.auth != null
                     && get(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid)).data.status == 'active'
                     && get(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid)).data.role == 'member'
                     && request.resource.data.loggedByUid == request.auth.uid;
      allow update, delete: if request.auth != null
                              && resource.data.loggedByUid == request.auth.uid
                              && exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid));
    }

    // Per-user fan-out index ("which pools am I in"), so listing your
    // own pools never has to scan every pools/* doc looking for
    // membership - just a get/list on your own uid's own subcollection,
    // same cheap shape as everything else in this file. Only ever
    // created once an active membership doc for that exact pool genuinely
    // exists (checked directly, not just asserted by the client).
    match /userPools/{uid}/pools/{poolId} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                     && get(/databases/$(database)/documents/pools/$(poolId)/members/$(uid)).data.status == 'active';
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    // Pool invites. Deterministic doc id (poolId_invitedUid) rather than
    // an auto-id - lets the membership rule above verify one specific
    // accepted invite by direct key rather than a query, and also means
    // at most one pending invite can ever exist per pool+person pair (a
    // second invite() call while one's already pending just fails
    // outright rather than creating a duplicate - `create` in Firestore
    // rules only ever matches when no document already exists at that
    // id). Only the two people involved can ever read one; only an
    // already-active member of the target pool can create one; only the
    // invited person can accept/decline it, and only that one field.
    match /invites/{inviteId} {
      allow get, list: if request.auth != null
                         && (resource.data.invitedUid == request.auth.uid
                             || resource.data.invitedByUid == request.auth.uid);
      allow create: if request.auth != null
                     && inviteId == request.resource.data.poolId + '_' + request.resource.data.invitedUid
                     && request.resource.data.invitedByUid == request.auth.uid
                     && request.resource.data.status == 'pending'
                     && get(/databases/$(database)/documents/pools/$(request.resource.data.poolId)/members/$(request.auth.uid)).data.status == 'active';
      allow update: if request.auth != null
                     && request.auth.uid == resource.data.invitedUid
                     && resource.data.status == 'pending'
                     && request.resource.data.status in ['accepted', 'declined']
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Lift Plan Library - a company-wide, browsable knowledge base (NOT
    // pool-scoped like the shared lift log above): documented past lifts,
    // organised into a free-form category tree anyone can extend as they
    // go (e.g. Rio Tinto -> Yandi -> Tertiary Crushers, or a non-site
    // branch like HME -> Hitachi EX5600), so someone tackling the same
    // lift again can find write-ups from whoever's done it before.
    // Deliberately open to any signed-in user, same "signed in is enough"
    // bar as pools/directory above - built by the whole user base, not
    // curated by an admin.

    // The tree itself: a flat collection keyed by auto-id, each doc just
    // {name, parentId}. Flat + parentId (rather than nested
    // subcollections, like pools/lifts above) is what lets this go to any
    // depth - a subcollection-per-level approach needs a fixed max
    // nesting depth hardcoded into rules, which doesn't fit a tree meant
    // to be extended indefinitely; a parentId query works at any depth
    // without a rules change. Listable in full (unlike pools) since
    // browsing/searching the whole tree is the point. Still no delete
    // from the client - that would need to also decide what happens to
    // any children or entries under it. Rename/move (changing name
    // and/or parentId) IS now admin-only - the user base builds the
    // tree by creating freely, but only an admin can reorganise it
    // afterward (e.g. a flat "Royhill Mine Crusher 1" node moved to
    // become a proper Royhill > Mine > ROM > 2 > Crusher > 1 >
    // Secondary Crushers leaf once that structure exists) - a curation
    // step on top of the free-for-all build step, not instead of it.
    // Moving a category is just changing this ONE doc's parentId - its
    // whole subtree (further categories AND entries, since entries
    // reference categoryId directly, never a path) comes along for
    // free, no cascade needed. createdBy/createdByName/createdAt stay
    // fixed (diff().affectedKeys() only allows name/parentId to
    // actually change) - moving/renaming a category doesn't rewrite
    // who originally made it or when. Cycle prevention (can't move a
    // category into its own descendant) is enforced client-side only -
    // rules can't cheaply walk an arbitrary-depth ancestor chain the
    // way a flat parentId tree needs - direct self-parenting is still
    // blocked here as a cheap baseline.
    match /liftLibraryCategories/{categoryId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.keys().hasOnly(['name', 'parentId', 'createdBy', 'createdByName', 'createdAt'])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.name.size() <= 80
                     && (request.resource.data.parentId == null
                         || (request.resource.data.parentId is string
                             && exists(/databases/$(database)/documents/liftLibraryCategories/$(request.resource.data.parentId))))
                     && request.resource.data.createdBy == request.auth.uid
                     && request.resource.data.createdAt is int;
      allow update: if request.auth != null
                     && isAdmin()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'parentId'])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.name.size() <= 80
                     && (request.resource.data.parentId == null
                         || (request.resource.data.parentId is string
                             && request.resource.data.parentId != categoryId
                             && exists(/databases/$(database)/documents/liftLibraryCategories/$(request.resource.data.parentId))));
      allow delete: if false;
    }

    // The actual lift write-ups. entryId is generated CLIENT-SIDE before
    // either the Storage photos or this doc are created (see index.html's
    // lift library submit flow), specifically so the two stay linked by
    // the same id without a round trip. Storage's OWN rules used to check
    // this doc's loggedByUid via firestore.get() to decide who can delete
    // an uploaded photo - dropped that (methodology.txt 130) once live
    // testing found firestore.get() from Storage rules silently doesn't
    // work when the Storage bucket and this Firestore database aren't in
    // the same location, which they aren't here; photo ownership is
    // tracked in Storage's own object metadata now instead. Only the
    // original logger (or an admin) can edit/delete their own entry -
    // same "you can only touch your own" shape as pools/lifts above, just
    // without a pool-membership check since this isn't pool-scoped.
    match /liftLibraryEntries/{entryId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.keys().hasAll(['categoryId', 'title', 'loggedByUid', 'loggedByName', 'createdAt'])
                     && request.resource.data.keys().hasOnly(['categoryId', 'title', 'asset', 'part', 'weightValue', 'weightUnit', 'craneModel', 'counterweightCombo', 'boomLength', 'hookBlock', 'riggingChains', 'riggingShackles', 'photos', 'video', 'pdfs', 'notes', 'externalLink', 'loggedByUid', 'loggedByName', 'createdAt'])
                     && request.resource.data.categoryId is string
                     && exists(/databases/$(database)/documents/liftLibraryCategories/$(request.resource.data.categoryId))
                     && request.resource.data.title is string
                     && request.resource.data.title.size() > 0
                     && request.resource.data.title.size() <= 120
                     && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 20))
                     // video is one object, not a list (see index.html's own
                     // llPendingVideoFile - one video slot per entry, kept
                     // deliberately simple given the size/bandwidth this one
                     // costs relative to a photo - see methodology).
                     && (!('video' in request.resource.data) || request.resource.data.video is map)
                     // pdfs is a list like photos, not a single slot like
                     // video - a real lift plan often comes with several
                     // reference documents (OEM chart + a separate COG
                     // drawing, etc.), and a PDF's own bandwidth cost is
                     // much closer to a photo's than to real video.
                     && (!('pdfs' in request.resource.data) || (request.resource.data.pdfs is list && request.resource.data.pdfs.size() <= 10))
                     && request.resource.data.loggedByUid == request.auth.uid
                     && request.resource.data.createdAt is int;
      allow update, delete: if request.auth != null
                              && (resource.data.loggedByUid == request.auth.uid || isAdmin());
    }

    // Deny everything else outright - an explicit fallback rather than
    // relying on Firestore's own "no matching rule = denied" default, so
    // adding some unrelated collection later can't accidentally inherit
    // more access than intended just by sitting under the same database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
